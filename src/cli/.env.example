# ============================================
# 37AC CLI 客户端环境变量配置模板
# ============================================
# 复制此文件为 .env 并填入你的真实配置值
# cp .env.example .env

# --- 节点服务配置 ---
TCP_HOST=127.0.0.1
TCP_PORT=13137
LOCAL_PORT=
NODE_ID=1
TOKEN=your-node-token
# 节点选择的识别模型（注册后按 register_ack.data.models 里该模型的 config_url 同步下载）
MODEL_ID=37ac

# --- 心跳配置 ---
HEARTBEAT_INTERVAL_SEC=15
HEARTBEAT_RESPONSE_TIMEOUT_SEC=30
HEARTBEAT_MISS_LIMIT=3
RECONNECT_DELAY_SEC=10

# --- 任务配置 ---
MAX_TASKS=5
# 本地推理超时（秒）：首次加载模型 / YOLO 检测可能较慢，作为后台线程安全兜底，超时自动返回失败
LOCAL_TASK_TIMEOUT_SEC=120

# --- 第三方大模型识别配置 ---
# 启用后节点会优先使用多模态 API 代替本地 ResNet 模型
LLM_RECOGNITION_ENABLED=False
# 训练结束后是否使用 LLM 为每个角色生成 features_used/tags 并写入 classes.json
# （需同时开启 LLM_RECOGNITION_ENABLED；会按角色逐个调用 API，注意成本）
LLM_ENRICH_FEATURES=False
# 实验性：LLM 识别时把 classes.json 中已知角色的特征/标签附加到提示词对照匹配
# （需同时开启 LLM_RECOGNITION_ENABLED，并先用 LLM_ENRICH_FEATURES 生成角色档案）
LLM_DB_RECOGNITION=False
LLM_API_KEY=your-deepseek-api-key
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
# API 类型: chat-completions（OpenAI 兼容格式，默认）/ responses（OpenAI Responses API）
#           / anthropic（Anthropic Messages API）/ ollama（Ollama 原生 /api/chat）
LLM_API_TYPE=chat-completions
LLM_MODEL_NAME=deepseek-v4.1-pro
LLM_TIMEOUT_SEC=30
# 单次 LLM 推理的最大输出 token 数（推理模型思考+结论所需，默认 2048）
LLM_MAX_TOKEN=2048
# 是否开启模型思考（推理）模式：false=关闭思考（默认，直接输出结果）/ true=开启推理过程
LLM_THINKING=false
LLM_PROMPT_TEMPLATE=

# --- YOLO 检测配置 ---
# YOLO（快速定位）+ ResNet（角色分类）
YOLO_ENABLED=True
# 模型文件路径（默认指向项目根目录的 yolov8n.pt）
YOLO_MODEL_PATH=
# 检测置信度阈值（低于此值的目标被忽略）
YOLO_CONFIDENCE=0.25

# --- 训练配置 ---
DATASET_DIR=W:/Img
NUM_EPOCHS=50
BATCH_SIZE=16
IMAGE_SIZE=224
LEARNING_RATE=1e-4
# 分阶段微调（基于 ImageNet 预训练权重）
PHASE1_EPOCHS=10    # 阶段1：冻结 backbone，仅训练 FC+CBAM
PHASE1_LR=1e-3      # 阶段1：高学习率快速拟合头部
PHASE2_LR=1e-4      # 阶段2：解冻全部，余弦退火全局精调
PHASE2_MIN_LR=1e-6  # 阶段2：最小学习率
# 正则化与数据增强
WEIGHT_DECAY=1e-4      # 权重衰减（L2正则化）
LABEL_SMOOTHING=0.1    # 标签平滑（缓解过拟合）
GRAD_CLIP_NORM=1.0     # 梯度裁剪最大范数
# 早停（连续 X 轮无提升即停止，0=禁用）
EARLY_STOP_PATIENCE=10
# 验证集比例（0=不使用验证集）
VAL_SPLIT_RATIO=0.2
# DataLoader 工作进程数
NUM_WORKERS=2
MODEL_FILENAME=37ac-v0.0.1.pth
YOLO_ENABLED=True
YOLO_CONFIDENCE=0.25
MAX_IMAGES_PER_ROLE=100

# --- 设备配置 ---
# 自动选择设备（GPU/CPU）
AUTO_DEVICE=True
# 强制指定设备（cpu/cuda），AUTO_DEVICE=False 时生效
DEVICE=cpu
# 使用 DirectML (AMD GPU) — 适用于 RX 580 等 AMD 显卡
USE_DIRECTML=False

# --- 调试模式 ---
TSAC_DEBUG=False
