# ============================================
# 37AC CLI 客户端环境变量配置模板
# ============================================
# 复制此文件为 .env 并填入你的真实配置值
# cp .env.example .env

# --- 节点服务配置 ---
TCP_HOST=127.0.0.1
TCP_PORT=13137
LOCAL_PORT=
NODE_ID=1
TOKEN=your-node-token
# 节点选择的识别模型（注册后按 register_ack.data.models 里该模型的 config_url 同步下载）
MODEL_ID=37ac
# 模型自动更新开关：True=节点注册后自动检查服务端模型版本并下载新版本；
# False=不检查不更新，仅当本地模型/类别文件缺失时下载一次（可用 node --no-model-update 临时覆盖）
AUTO_UPDATE_MODEL=True

# --- 心跳配置 ---
HEARTBEAT_INTERVAL_SEC=15
HEARTBEAT_RESPONSE_TIMEOUT_SEC=30
HEARTBEAT_MISS_LIMIT=3
RECONNECT_DELAY_SEC=10

# --- 任务配置 ---
MAX_TASKS=5
# 本地推理超时（秒）：首次加载模型 / YOLO 检测可能较慢，作为后台线程安全兜底，超时自动返回失败
LOCAL_TASK_TIMEOUT_SEC=120

# --- 第三方大模型识别配置 ---
# 启用后节点会优先使用多模态 API 代替本地 ResNet 模型
LLM_RECOGNITION_ENABLED=False
# 训练结束后是否使用 LLM 为每个角色生成 features_used/tags 并写入 classes.json
# （需同时开启 LLM_RECOGNITION_ENABLED；会按角色逐个调用 API，注意成本）
LLM_ENRICH_FEATURES=False
# 实验性：LLM 识别时把 classes.json 中已知角色的特征/标签附加到提示词对照匹配
# （需同时开启 LLM_RECOGNITION_ENABLED，并先用 LLM_ENRICH_FEATURES 生成角色档案）
LLM_DB_RECOGNITION=False
LLM_API_KEY=your-deepseek-api-key
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
# API 类型: chat-completions（OpenAI 兼容格式，默认）/ responses（OpenAI Responses API）
#           / anthropic（Anthropic Messages API）/ ollama（Ollama 原生 /api/chat）
LLM_API_TYPE=chat-completions
LLM_MODEL_NAME=deepseek-v4.1-pro
# ==================== 内存/资源开关（小内存机器按需调） ====================
# 本地模型（YOLO + ResNet）：关闭后节点只做 LLM 识别，
# torch/torchvision 永不加载，空闲进程从 ~460MB 降到 ~21MB
LOCAL_RECOGNITION_ENABLED=True
# MediaPipe 第二种裁剪方式：关闭后 CROP_METHOD=auto 不再回退到它（省 10~67MB）
MEDIAPIPE_ENABLED=True
# torch 线程数上限（0=不干预）。小内存/共享 CPU 建议 1~2：
# 线程越多，torch 预留的线程 arena 越大（Windows 提交大小会明显上涨）
TORCH_NUM_THREADS=0

# 一图多角（裁剪方案）：先用检测器把每个人切成子图，再逐张问 LLM
# 人物框来自检测器（比让大模型猜坐标准），模型每次只看一个人，识别也更准
LLM_MULTI_CHARACTER=True
# 一层图最多识别人物数（**每个人物 = 一次 LLM 调用**，注意成本与耗时）
LLM_MAX_CHARACTERS=8
# ==================== 裁剪质量门控（实测：误检框会拉低准确率） ====================
# 背景：YOLOv8n 是 COCO 真人检测器，在二次元/插画上会误检多检，裁错框不如不裁。
# 实测（91 类 / 538 张原始网图，同一批样本）：不裁剪 79.6% vs 直接裁剪 73.2%；
# 门控只把 top-3 从 79.2% 提到 81.2%，top-1 仍是 73.0% —— 精度优先请直接关掉裁剪。
# 开启后只有"置信度 + 面积占比"达标的框才用于裁剪，否则回退整图识别
CROP_QUALITY_GATE=True
CROP_MIN_CONFIDENCE=0.35
CROP_MIN_AREA_RATIO=0.06
CROP_MAX_AREA_RATIO=0.98
# 完全关掉裁剪（最省事、也是当前实测最稳的一档）：
# YOLO_ENABLED=False

# 切图检测器：auto（本地模型开启→yolo，只做 LLM→mediapipe）/ yolo / mediapipe / none（不切图）
LLM_CROP_METHOD=auto
# 子图送模型前的最长边（越小越省 token）
LLM_CROP_MAX_SIDE=768
# 整图送模型前的最长边（不切图时的回退路径）
LLM_IMAGE_MAX_SIDE=1024
# 自定义提示词（留空则按上面的开关使用内置的多角色/单角色默认提示词）
# LLM_PROMPT_TEMPLATE=
LLM_TIMEOUT_SEC=30
# 单次 LLM 推理的最大输出 token 数（推理模型思考+结论所需，默认 2048）
LLM_MAX_TOKEN=2048
# 是否开启模型思考（推理）模式：false=关闭思考（默认，直接输出结果）/ true=开启推理过程
LLM_THINKING=false
LLM_PROMPT_TEMPLATE=

# --- YOLO 检测配置 ---
# YOLO（快速定位）+ ResNet（角色分类）
YOLO_ENABLED=True
# 模型文件路径（默认指向项目根目录的 yolov8n.pt）
YOLO_MODEL_PATH=
# 检测置信度阈值（低于此值的目标被忽略）
YOLO_CONFIDENCE=0.25

# --- 训练配置 ---
DATASET_DIR=W:/Img
NUM_EPOCHS=50
BATCH_SIZE=16
IMAGE_SIZE=224
LEARNING_RATE=1e-4
# 分阶段微调（基于 ImageNet 预训练权重）
PHASE1_EPOCHS=10    # 阶段1：冻结 backbone，仅训练 FC+CBAM
PHASE1_LR=1e-3      # 阶段1：高学习率快速拟合头部
PHASE2_LR=1e-4      # 阶段2：解冻全部，余弦退火全局精调
PHASE2_MIN_LR=1e-6  # 阶段2：最小学习率
# 正则化与数据增强
WEIGHT_DECAY=1e-4      # 权重衰减（L2正则化）
LABEL_SMOOTHING=0.1    # 标签平滑（缓解过拟合）
GRAD_CLIP_NORM=1.0     # 梯度裁剪最大范数
# 早停（连续 X 轮无提升即停止，0=禁用）
EARLY_STOP_PATIENCE=10
# 验证集比例（0=不使用验证集）
VAL_SPLIT_RATIO=0.2
# DataLoader 工作进程数
NUM_WORKERS=2
MODEL_FILENAME=37ac-v0.0.1.pth
YOLO_ENABLED=True
YOLO_CONFIDENCE=0.25
MAX_IMAGES_PER_ROLE=100

# --- 数据集压缩 ---
# 裁剪前先把图片最长边压到该值以内再做 YOLO（0=禁用）；512 兼顾清晰度与速度
DATASET_COMPRESS_SIZE=512
# JPEG 压缩质量（1-100）
DATASET_COMPRESS_QUALITY=90
# 压缩并发线程数
DATASET_COMPRESS_WORKERS=4
# YOLO 裁剪并发线程数（按角色并行，每线程独立加载一个 YOLO 模型；CPU 建议 2-4，GPU 建议 1）
YOLO_CROP_WORKERS=2

# --- 设备配置 ---
# 自动选择设备（GPU/CPU）
AUTO_DEVICE=True
# 强制指定设备（cpu/cuda），AUTO_DEVICE=False 时生效
DEVICE=cpu
# 使用 DirectML (AMD GPU) — 适用于 RX 580 等 AMD 显卡
USE_DIRECTML=False

# --- 调试模式 ---
TSAC_DEBUG=False
