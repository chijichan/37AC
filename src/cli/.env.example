# ============================================================
#  37AC 边缘节点配置
# ------------------------------------------------------------
#  · 本文件包含全部可配置项；删除或注释掉某一行即回落到代码内置默认值
#  · 改完保存后重启节点生效（python main.py node）
#  · 各段说明见 docs/usage.md
# ============================================================

# ==================== 1. 调试 ====================
# true 时输出更详细的日志（排查问题用）
TSAC_DEBUG=False

# ==================== 2. 设备与推理后端 ====================
# 自动选择设备；False 时按下面 DEVICE 指定
AUTO_DEVICE=True

# AUTO_DEVICE=False 时生效：cpu / cuda / dml
DEVICE=

# AUTO_DEVICE=True 时是否尝试 DirectML（AMD/Intel，Windows，需 torch-directml）
USE_DIRECTML=False

# torch 线程上限（0=不限制）；小内存/共享 CPU 建议 1~2，可降低提交内存与 CPU 争抢
TORCH_NUM_THREADS=0

# ==================== 3. 资源占用（内存敏感机器可关） ====================
# 本地模型识别总开关；False=本节点只做 LLM（不加载 torch，空闲约 21MB）
LOCAL_RECOGNITION_ENABLED=True

# MediaPipe 裁剪开关；False=不 import mediapipe（省 10~67MB）
MEDIAPIPE_ENABLED=True

# ==================== 4. 节点连接与任务 ====================
# 服务端 TCP 地址
TCP_HOST=127.0.0.1

# 服务端 TCP 端口
TCP_PORT=13137

# 本地监听端口（空=随机）
LOCAL_PORT=

# 本节点在服务端注册的编号
NODE_ID=1

# 节点认证 Token（与服务端 nodes 表一致）
TOKEN=

# 节点使用的识别模型 ID（注册后按服务端下发同步）
MODEL_ID=37ac

# 服务端 HTTP 地址（备用，模型同步走 TCP）
SERVER_HTTP_URL=http://127.0.0.1:13138

# 启动时自动检查/下载新模型；False=仅缺失时下载一次
AUTO_UPDATE_MODEL=True

# 心跳间隔（秒）
HEARTBEAT_INTERVAL_SEC=15

# 心跳响应超时（秒）
HEARTBEAT_RESPONSE_TIMEOUT_SEC=30

# 连续丢失多少次心跳判定断线
HEARTBEAT_MISS_LIMIT=3

# 断线重连间隔（秒）
RECONNECT_DELAY_SEC=10

# 单节点同时处理的任务数上限
MAX_TASKS=5

# 单个任务处理超时（秒）
LOCAL_TASK_TIMEOUT_SEC=120

# 任务完成后本地图片保留秒数（供服务端补拉；0=立即删除）
IMAGE_RETAIN_SEC=900

# ==================== 5. 本地模型识别（YOLO + ResNet） ====================
# 是否先检测/裁剪人物；关闭=整图识别（实测原始图整图更准，见 docs/usage.md）
YOLO_ENABLED=True

# YOLO 权重路径（空=用 saves/models/yolov8n.pt）
YOLO_MODEL_PATH=

# YOLO 检测置信度阈值
YOLO_CONFIDENCE=0.25

# YOLO 检测设备：cpu（默认，稳定）/ cuda / dml / auto\n# DirectML 跑 YOLO 会抛 utf-8 异常并可能卡死裁剪，故默认 CPU\nYOLO_DEVICE=cpu\n
# 检测前把最长边缩到该值（越大越准越慢）
YOLO_DETECT_MAX_SIZE=1024

# 数据集裁剪并发线程数（每线程一份 YOLO 模型，内存敏感时设 1）
YOLO_CROP_WORKERS=2

# 识别时是否先检测多个人物
MULTI_CHARACTER_ENABLED=True

# 单图最多识别几个人物
MAX_CHARACTERS=10

# 裁剪框外扩比例
CROP_MARGIN_RATIO=0.08

# 裁剪方式：yolo / mediapipe / auto
CROP_METHOD=auto

# 裁剪质量门控：框太小/太大/置信度低视为无效（回退整图）
CROP_QUALITY_GATE=True

# 门控：检测置信度下限
CROP_MIN_CONFIDENCE=0.35

# 门控：框面积占整图比例下限
CROP_MIN_AREA_RATIO=0.06

# 门控：框面积占整图比例上限
CROP_MAX_AREA_RATIO=0.98

# MediaPipe 检测置信度阈值
MEDIAPIPE_MIN_CONFIDENCE=0.4

# MediaPipe 人脸框横向外扩倍数（还原半身）
MEDIAPIPE_FACE_EXPAND_W=2.4

# MediaPipe 人脸框纵向外扩倍数
MEDIAPIPE_FACE_EXPAND_H=3.2

# 姿态模型复杂度：0=lite / 1=full / 2=heavy
MEDIAPIPE_POSE_COMPLEXITY=0

# 人脸模型：0=近景 / 1=全景长焦
MEDIAPIPE_FACE_MODEL_SELECTION=1

# ==================== 6. LLM 识别（第三方多模态模型） ====================
# 是否启用 LLM 识别通道
LLM_RECOGNITION_ENABLED=False

# 让模型输出 features_used/tags
LLM_ENRICH_FEATURES=False

# features_used / tags 每项最多保留多少条（LLM 多给的截断，0=不限制）；
# 训练补全时两个字段都已达到上限的角色直接跳过，不再调用 LLM
LLM_MAX_FEATURES=3
LLM_MAX_TAGS=3

# 实验性：把 classes.json 角色档案拼进提示词并交叉计算置信度
LLM_DB_RECOGNITION=False

# 接口类型：chat-completions / responses / anthropic / ollama
LLM_API_TYPE=

# 接口地址（OpenAI 兼容）
LLM_API_URL=https://api.deepseek.com/v1/chat/completions

# API Key（留空则不发送 Authorization 头）
LLM_API_KEY=

# 模型名
LLM_MODEL_NAME=deepseek-v4.1

# 单次请求超时（秒）
LLM_TIMEOUT_SEC=30

# 限流/服务端错误重试：单次请求的总尝试次数（含首次）
LLM_MAX_ATTEMPTS=3
# 退避基数与上限（秒）：第 n 次失败后等待 base*2^(n-1)，有 Retry-After 头则优先按它
LLM_RETRY_BASE_SEC=2
LLM_RETRY_MAX_SEC=30
# 单张图所有 LLM 请求的总时间预算（秒，0=不限）；一图多角发多次请求时兜住总耗时
LLM_MAX_TOTAL_SEC=90

# 单次回复最大 token（推理模型需要更大）
LLM_MAX_TOKEN=2048

# 是否开启模型思考过程（更慢更贵，一般关闭）
LLM_THINKING=False

# 自定义提示词（留空=用内置默认提示词）
LLM_PROMPT_TEMPLATE=

# 一图多角：先切图再逐张问模型（False=整图一次）
LLM_MULTI_CHARACTER=True

# 一图最多识别人物数（**每个人物=一次 LLM 调用**）
LLM_MAX_CHARACTERS=8

# 切图检测器：auto（本地模型开→yolo，只做 LLM→mediapipe）/ yolo / mediapipe / none
LLM_CROP_METHOD=auto

# 子图送模型前最长边（越小越省 token）
LLM_CROP_MAX_SIDE=768

# 整图送模型前最长边（不切图时）
LLM_IMAGE_MAX_SIDE=1024

# ==================== 7. 训练 ====================
# 原始数据集目录（IP/角色/图片）
DATASET_DIR=W:/Img

# 训练产出的权重文件名（保存在 saves/models）
MODEL_FILENAME=37ac-v0.0.1.pth

# 从指定权重继续训练（空=用 ImageNet 预训练）
RESUME_MODEL_PATH=

# 总训练轮数
NUM_EPOCHS=50

# 批大小
BATCH_SIZE=16

# 输入分辨率（提高可涨点但更慢）
IMAGE_SIZE=224

# 基础学习率
LEARNING_RATE=1e-4

# 阶段1（冻结 backbone）轮数
PHASE1_EPOCHS=10

# 阶段1 学习率
PHASE1_LR=1e-3

# 阶段2（解冻精调）学习率
PHASE2_LR=1e-4

# 阶段2 余弦退火最小学习率
PHASE2_MIN_LR=1e-6

# 权重衰减
WEIGHT_DECAY=1e-4

# 标签平滑
LABEL_SMOOTHING=0.1

# 梯度裁剪最大范数
GRAD_CLIP_NORM=1.0

# 早停耐心轮数（0=不用）
EARLY_STOP_PATIENCE=10

# 验证集比例（0=不划分）
VAL_SPLIT_RATIO=0.2

# DataLoader 工作进程数
NUM_WORKERS=4

# ==================== 8. 数据集构建（裁剪 / 压缩） ====================
# 每个角色最多保留多少张
MAX_IMAGES_PER_ROLE=100

# 图片最长边压到该值以内（0=禁用压缩）
DATASET_COMPRESS_SIZE=512

# JPEG 压缩质量（1-100）
DATASET_COMPRESS_QUALITY=90

# 压缩并发线程数
DATASET_COMPRESS_WORKERS=4

# 【不处理列表】这些源目录直接当数据集用、不做 YOLO 裁剪；多个用分号分隔
DATASET_IGNORE_PATHS=

# 命中的目录若在数据集里已有旧产物，是否顺手清理（False=只跳过、不删）
DATASET_IGNORE_CLEAN=True

# 裁剪不出人物时：是否用整图（压缩后）补足 MAX_IMAGES_PER_ROLE（False=直接丢弃，旧行为）
# 说明：优先保留 YOLO 裁剪图，只有"裁剪成功数 < MAX_IMAGES_PER_ROLE"时才用整图补齐，不会挤掉可裁剪样本
DATASET_FILL_UNCROPPED=True

# ==================== 9. 保留（当前代码未读取，仅作记录） ====================
# （未使用）HTTP 代理开关
HTTP_PROXY_ENABLED=

# （未使用）HTTP 代理地址
HTTP_PROXY_HOST=

# （未使用）HTTP 代理端口
HTTP_PROXY_PORT=

# （未使用）WebSocket 代理开关
WS_PROXY_ENABLED=

# （未使用）WS 代理地址
WS_PROXY_HOST=

# （未使用）WS 代理端口
WS_PROXY_PORT=
