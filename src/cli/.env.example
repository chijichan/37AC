# ============================================
# 37AC CLI 客户端环境变量配置模板
# ============================================
# 复制此文件为 .env 并填入你的真实配置值
# cp .env.example .env

# --- 节点服务配置 ---
TCP_HOST=127.0.0.1
TCP_PORT=13137
LOCAL_PORT=
NODE_ID=1
TOKEN=your-node-token

# --- 心跳配置 ---
HEARTBEAT_INTERVAL_SEC=15
HEARTBEAT_RESPONSE_TIMEOUT_SEC=30
HEARTBEAT_MISS_LIMIT=3
RECONNECT_DELAY_SEC=10

# --- 任务配置 ---
MAX_TASKS=5

# --- 第三方大模型识别配置 ---
# 启用后节点会优先使用多模态 API 代替本地 ResNet 模型
LLM_RECOGNITION_ENABLED=False
LLM_API_KEY=your-deepseek-api-key
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_MODEL_NAME=deepseek-v4.1-pro
LLM_TIMEOUT_SEC=30
LLM_PROMPT_TEMPLATE=

# --- P2P 配置 ---
# 信令服务器地址（与服务器端配置一致）
P2P_SIGNALING_HOST=127.0.0.1
P2P_SIGNALING_PORT=13139
# STUN 服务器地址，用于 NAT 穿透
P2P_STUN_SERVER=stun:stun.l.google.com:19302
# 是否启用 P2P 信令连接
P2P_ENABLED=False

# --- 浏览器代理接口 ---
HTTP_PROXY_ENABLED=False
HTTP_PROXY_HOST=0.0.0.0
HTTP_PROXY_PORT=8080
WS_PROXY_ENABLED=False
WS_PROXY_HOST=0.0.0.0
WS_PROXY_PORT=8081

# --- 训练配置 ---
DATASET_DIR=W:/Img
NUM_EPOCHS=50
BATCH_SIZE=16
IMAGE_SIZE=224
LEARNING_RATE=1e-4

# --- 设备配置 ---
AUTO_DEVICE=True
DEVICE=cpu

# --- 调试模式 ---
TSAC_DEBUG=False
